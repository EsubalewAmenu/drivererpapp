{
  "id": "invoicing",
  "name": "Invoicing",
  "icon": "account_balance",
  "primaryColor": "#6366F1",
  "version": 1,
  "settings": {
    "id": {
      "label": "Module ID",
      "type": "text",
      "value": "invoicing"
    },
    "icon": {
      "label": "Icon",
      "type": "icon",
      "value": "account_balance"
    },
    "primaryColor": {
      "label": "Primary Color",
      "type": "color",
      "value": "#6366F1"
    },
    "version": {
      "label": "Version",
      "type": "text",
      "value": "1.0"
    },
    "name": {
      "label": "Name",
      "type": "text",
      "value": "Invoicing",
      "help": "Main module title"
    }
  },
  "dashboard": {
    "cards": [
      {
        "label": "Sales Invoices Records",
        "type": "kpi",
        "query": {
          "collection": "invoices",
          "operation": "count"
        }
      },
      {
        "label": "Total Total",
        "type": "kpi",
        "format": "currency",
        "query": {
          "collection": "invoices",
          "operation": "sum",
          "field": "total_amount"
        }
      }
    ]
  },
  "collections": [
    {
      "id": "invoices",
      "label": "Sales Invoices",
      "depends_on": "settings.enable_invoicing",
      "enable_custom_filters": true,
      "load_related_data": false,
      "list_template": {
        "template": "standard",
        "title_key": "customer_ref",
        "subtitle_key": "inv_number",
        "trailing_key": "total_amount",
        "detail_keys": [
          "date_issued",
          "due_date",
          "status"
        ]
      },
      "detail_template": {
        "template": "standard",
        "title_key": "inv_number",
        "subtitle_key": "status",
        "show_all_fields": true
      },
      "quick_filters": [
        {
          "label": "Draft",
          "key": "draft",
          "rules": [
            {
              "field": "status",
              "operator": "==",
              "value": "Draft"
            }
          ]
        },
        {
          "label": "Unpaid",
          "key": "unpaid",
          "rules": [
            {
              "field": "status",
              "operator": "==",
              "value": "Unpaid"
            }
          ]
        },
        {
          "label": "Paid",
          "key": "paid",
          "rules": [
            {
              "field": "status",
              "operator": "==",
              "value": "Paid"
            }
          ]
        },
        {
          "label": "Void",
          "key": "void",
          "rules": [
            {
              "field": "status",
              "operator": "==",
              "value": "Void"
            }
          ]
        }
      ],
      "initial_data": [
        {
          "record_id": 1,
          "inv_number": "INV-2024-001",
          "customer_ref": 2,
          "date_issued": "2024-03-10",
          "due_date": "2024-03-20",
          "status": "Unpaid",
          "total_amount": 1500,
          "items": [
            {
              "description": "Consulting Service - Setup",
              "qty": 10,
              "rate": 100
            },
            {
              "description": "Software Installation",
              "qty": 1,
              "rate": 500
            }
          ]
        },
        {
          "record_id": 2,
          "inv_number": "INV-2024-002",
          "customer_ref": 2,
          "date_issued": "2024-03-12",
          "due_date": "2024-03-12",
          "status": "Paid",
          "total_amount": 49.99,
          "items": [
            {
              "description": "Laptop Stand (Cash Sale)",
              "qty": 1,
              "rate": 49.99
            }
          ]
        }
      ],
      "fields": [
        {
          "key": "inv_number",
          "label": "Invoice #",
          "type": "text",
          "required": true
        },
        {
          "key": "customer_ref",
          "label": "Customer",
          "type": "relation",
          "options": "contacts",
          "display_field": "name"
        },
        {
          "key": "date_issued",
          "label": "Date",
          "type": "date"
        },
        {
          "key": "due_date",
          "label": "Due Date",
          "type": "date"
        },
        {
          "key": "status",
          "label": "Status",
          "type": "select",
          "options": [
            "Draft",
            "Unpaid",
            "Paid",
            "Void"
          ]
        },
        {
          "key": "total_amount",
          "label": "Total",
          "type": "currency"
        },
        {
          "key": "items",
          "label": "Line Items",
          "type": "table",
          "fields": [
            {
              "key": "description",
              "label": "Description",
              "type": "text"
            },
            {
              "key": "qty",
              "label": "Qty",
              "type": "number"
            },
            {
              "key": "rate",
              "label": "Unit Price",
              "type": "currency"
            }
          ]
        }
      ]
    }
  ]
}
