{
  "id": "finance",
  "name": "Finance",
  "icon": "account_balance",
  "primaryColor": "#6366F1",
  "version": 1,
  "settings": {
    "id": {
      "label": "Module ID",
      "type": "text",
      "value": "finance"
    },
    "icon": {
      "label": "Icon",
      "type": "icon",
      "value": "account_balance"
    },
    "primaryColor": {
      "label": "Primary Color",
      "type": "color",
      "value": "#6366F1"
    },
    "version": {
      "label": "Version",
      "type": "text",
      "value": "1.0"
    },
    "name": {
      "label": "Name",
      "type": "text",
      "value": "Finance",
      "help": "Main module title"
    },
    "extensions": {
      "label": "Extensions",
      "type": "list",
      "value": [
        "Invoicing",
        "Expenses / Bills",
        "Fixed Assets (Free)",
        "Budgets (Free)"
      ]
    }
  },
  "dashboard": {
    "cards": [
      {
        "label": "Accounts Records",
        "type": "kpi",
        "query": {
          "collection": "chart_of_accounts",
          "operation": "count"
        }
      }
    ]
  },
  "collections": [
    {
      "id": "chart_of_accounts",
      "label": "Accounts",
      "enable_custom_filters": true,
      "load_related_data": false,
      "list_template": {
        "template": "standard",
        "title_key": "name",
        "subtitle_key": "code",
        "trailing_key": "type",
        "detail_keys": [
          "code",
          "type"
        ]
      },
      "detail_template": {
        "template": "standard",
        "title_key": "name",
        "subtitle_key": "type",
        "show_all_fields": true
      },
      "quick_filters": [
        {
          "label": "Assets",
          "key": "assets",
          "rules": [
            {
              "field": "type",
              "operator": "==",
              "value": "Asset"
            }
          ]
        },
        {
          "label": "Liabilities",
          "key": "liabilities",
          "rules": [
            {
              "field": "type",
              "operator": "==",
              "value": "Liability"
            }
          ]
        },
        {
          "label": "Revenue",
          "key": "revenue",
          "rules": [
            {
              "field": "type",
              "operator": "==",
              "value": "Revenue"
            }
          ]
        },
        {
          "label": "Expenses",
          "key": "expenses",
          "rules": [
            {
              "field": "type",
              "operator": "==",
              "value": "Expense"
            }
          ]
        }
      ],
      "initial_data": [
        {
          "record_id": 101,
