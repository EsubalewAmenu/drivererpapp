{
  "settings": {
    "id": { "label": "Module ID", "type": "text", "value": "inventory" },
    "icon": { "label": "Icon", "type": "icon", "value": "inventory_2_rounded" },
    "primaryColor": { "label": "Primary Color", "type": "color", "value": "#2196F3" },
    "version": { "label": "Version", "type": "text", "value": "1.0" },
    "name": { "label": "Name", "type": "text", "value": "Inventory" },
    "has_multiple_warehouses": { 
      "label": "Do you have multiple warehouses?", 
      "type": "boolean", 
      "value": false 
    },
    "warehouses": { 
      "label": "Warehouses", 
      "type": "list", 
      "value": ["Main Warehouse"],
      "depends_on": "has_multiple_warehouses" 
    }
  },
  "dashboard": {
    "cards": [
      {
        "label": "Stock Worth",
        "formula": "=SUMPRODUCT(stock_ledger!E:E, stock_ledger!D:D)", 
        "format": "currency"
      },
      {
        "label": "Shortages",
        "formula": "=COUNTIF(stock_ledger!D:D, \"<10\")",
        "format": "number"
      }
    ]
  },
  "tabs": [
    {
      "id": "stock_ledger",
      "label": "Stock Entries",
      "enable_custom_filters": true,
      "list_template": {
        "template": "standard",
        "title_key": "entry_date",
        "subtitle_key": "warehouse",
        "detail_keys": ["item_sku", "batch"]
      },
      "detail_template": {
        "template": "standard",
        "title_key": "entry_date",
        "subtitle_key": "warehouse",
        "show_all_fields": true
      },
      "quick_filters": [
        { "label": "All", "key": "all", "field": "warehouse", "operator": "contains", "value": "" },
        { "label": "Main Warehouse", "key": "main_warehouse", "field": "warehouse", "operator": "==", "value": "Main Warehouse" }
      ],
      "columns": [
        { "key": "entry_date", "label": "Date", "type": "date", "required": true },
        { "key": "item_sku", "label": "Item SKU", "type": "scanner" },
        { 
          "key": "warehouse", 
          "label": "Warehouse", 
          "type": "select",
          "options": "settings.warehouses",
          "depends_on": "settings.has_multiple_warehouses"
        },
        { "key": "batch", "label": "Batch Name", "type": "text" },
        { 
          "key": "items", 
          "label": "Items", 
          "type": "table", 
          "columns": [
             { "key": "item_ref", "label": "Select Item", "type": "relation", "options": "items" },
             { 
               "key": "variant", 
               "label": "Variant", 
               "type": "select", 
               "options": "item_ref.variants",
               "depends_on": "item_ref",
               "dynamic_label": "item_ref.variant_name"
             },
             { "key": "qty", "label": "Quantity", "type": "number" },
             { "key": "cost_price", "label": "Unit Cost", "type": "currency" }
          ]
        }
      ]
    },
    {
      "id": "items",
      "label": "Item Catalog",
      "enable_custom_filters": true,
      "list_template": {
        "template": "standard",
        "title_key": "item_name",
        "subtitle_logic": {
          "condition_key": "is_item_variants",
          "truthy_key": "variant_name",
          "falsy_key": "barcode_sku"
        },
        "trailing_key": "min_stock_alerts",
        "detail_keys": ["is_item_variants"]
      },
      "detail_template": {
        "template": "modern",
        "title_key": "item_name",
        "subtitle_logic": {
          "condition_key": "is_item_variants",
          "truthy_key": "variant_name",
          "falsy_key": "barcode_sku"
        },
        "image_key": "item_image",
        "show_all_fields": true
      },
      "quick_filters": [
        { "label": "All", "key": "all", "field": "item_name", "operator": "contains", "value": "" },
        { "label": "Low stock", "key": "low_stock", "field": "min_stock_alerts", "operator": "<", "value": "10" }
      ],
      "columns": [
        { "key": "item_image", "label": "Photo", "type": "image" },
        { "key": "item_name", "label": "Item Name", "type": "text", "required": true },
        { "key": "barcode_sku", "label": "SKU", "type": "scanner" },
        { "key": "is_item_variants", "label": "Does it have variants?", "type": "boolean" },
        { "key": "variant_name", "label": "Variant Name", "type": "text", "depends_on": "is_item_variants" },
        { 
          "key": "variants", 
          "label": "Variants", 
          "type": "list",
          "depends_on": "is_item_variants",
          "default": ["Small", "Big"]
        },
        { "key": "min_stock_alerts", "label": "Minimum Stock Alerts", "type": "number" }
      ]
    }
  ]
}