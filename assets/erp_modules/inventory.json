{
  "id": "inventory",
  "name": "Inventory",
  "icon": "inventory_2_rounded",
  "settings": {
    "primaryColor": "#2196F3",
    "version": "1.0"
  },
  "dashboard": {
    "kpiCards": [
      {
        "label": "Stock Worth",
        "calculation": "SUM(cost_price * qty)",
        "format": "currency"
      },
      {
        "label": "Shortages",
        "calculation": "COUNT(qty < 10)",
        "format": "number"
      }
    ]
  },
  "tabs": [
    {
      "id": "stock",
      "label": "Warehouse Inventory",
      "columns": [
        { "key": "product_image", "label": "Photo", "type": "image" },
        { "key": "item_name", "label": "Product", "type": "text" },
        { "key": "barcode_sku", "label": "SKU", "type": "scanner" },
        { 
          "key": "category", 
          "label": "Department", 
          "type": "select",
          "options": ["High-End Laptop", "Monitor", "Accessories", "Cables", "Software"]
        },
        { "key": "qty", "label": "Quantity", "type": "number" },
        { "key": "cost_price", "label": "Unit Cost", "type": "currency" },
        { 
          "key": "total_value", 
          "label": "Line Total", 
          "type": "formula",
          "formula": "qty * cost_price"
        }
      ]
    }
  ]
}