{
  "settings": {
    "id": { "label": "Module ID", "type": "text", "value": "inventory" },
    "icon": { "label": "Icon", "type": "icon", "value": "inventory_2_rounded" },
    "primaryColor": { "label": "Primary Color", "type": "color", "value": "#2196F3" },
    "version": { "label": "Version", "type": "text", "value": "1.0" },
    "name": { "label": "Name", "type": "text", "value": "Inventory" },
    
    "enable_variants": { 
      "label": "Product Variants (Size/Color)?", 
      "type": "boolean", 
      "value": true 
    },
    "enable_multi_warehouse": { 
      "label": "Enable Multi-Warehouse?", 
      "type": "boolean", 
      "value": false 
    },
    "enable_procurement": { 
      "label": "Enable Procurement?", 
      "type": "boolean", 
      "value": true 
    }

  },
  "dashboard": {"cards": [
      {
        "label": "Total Stock Value",
        "formula": "=SUMPRODUCT(variants!G:G, variants!H:H)", 
        "format": "currency"
      },
      {
        "label": "Low Stock Alerts",
        "formula": "=COUNTIF(variants!G:G, \"<10\")",
        "format": "number",
        "color": "#F44336"
      }
    ]
  },
  "tabs": [
      {
        "id": "products",
        "label": "Product Families",
        "columns": [
          { "key": "name", "label": "Product Name", "type": "text", "required": true },
          { "key": "category", "label": "Category", "type": "select", "options": ["Computers", "Accessories"] },
          { "key": "brand", "label": "Brand", "type": "text" },
          { "key": "has_variants", "label": "Has Variants?", "type": "boolean", "default": false }
        ],
        "initial_data": [
          {
            "record_id": 1,
            "name": "MacBook Pro M3",
            "category": "Computers",
            "brand": "Apple",
            "has_variants": true
          },
          {
            "record_id": 2,
            "name": "Aluminum Laptop Stand",
            "category": "Accessories",
            "brand": "Rain Design",
            "has_variants": false
          }
        ]
      },
      {
        "id": "variants",
        "label": "Items / SKUs",
        "list_template": {
          "template": "standard",
          "title_key": "full_name",
          "subtitle_key": "sku",
          "trailing_key": "qty_on_hand"
        },
        "columns": [
          { "key": "parent_product", "label": "Product Family", "type": "relation", "options": "products", "display_field": "name", "required": true },
          { "key": "size", "label": "Size", "type": "select", "options": ["14-inch", "16-inch"], "depends_on": "parent_product.has_variants", "depends_value": true },
          { "key": "color", "label": "Color", "type": "select", "options": ["Space Gray", "Silver"], "depends_on": "parent_product.has_variants", "depends_value": true },
          { 
            "key": "full_name", 
            "label": "Item Name", 
            "type": "formula", 
            "formula": "=IF(parent_product.has_variants, parent_product.name & \" - \" & color & \"/\" & size, parent_product.name)" 
          },
          { "key": "sku", "label": "SKU", "type": "scanner", "required": true },
          { "key": "price", "label": "Selling Price", "type": "currency" },
          { "key": "qty_on_hand", "label": "Stock", "type": "number", "readonly": true }
        ],
        "initial_data": [
          {
            "record_id": 101,
            "parent_product": 1, 
            "size": "14-inch",
            "color": "Space Gray",
            "full_name": "MacBook Pro M3 - Space Gray/14-inch",
            "sku": "MBP-14-SG",
            "price": 1599,
            "qty_on_hand": 10
          },
          {
            "record_id": 102,
            "parent_product": 1,
            "size": "16-inch",
            "color": "Silver",
            "full_name": "MacBook Pro M3 - Silver/16-inch",
            "sku": "MBP-16-SL",
            "price": 2499,
            "qty_on_hand": 5
          },
          {
            "record_id": 103,
            "parent_product": 2,
            "size": "", 
            "color": "", 
            "full_name": "Aluminum Laptop Stand", 
            "sku": "ACC-STD-001",
            "price": 49.99,
            "qty_on_hand": 50
          }
        ]
      },
      {
        "id": "stock_ledger",
        "label": "Stock Adjustment",
        "columns": [
          { "key": "date", "label": "Date", "type": "date" },
          { "key": "type", "label": "Type", "type": "select", "options": ["In", "Out"] },
          { "key": "item_ref", "label": "Item", "type": "relation", "options": "variants", "display_field": "full_name" },
          { "key": "qty", "label": "Qty", "type": "number" },
          { "key": "notes", "label": "Note", "type": "text" }
        ],
        "initial_data": [
          {
            "record_id": 1,
            "date": "2024-03-01",
            "type": "In",
            "item_ref": 101,
            "qty": 10,
            "notes": "Initial Apple Shipment"
          },
          {
            "record_id": 2,
            "date": "2024-03-01",
            "type": "In",
            "item_ref": 102,
            "qty": 5,
            "notes": "Initial Apple Shipment"
          },
          {
            "record_id": 3,
            "date": "2024-03-05",
            "type": "In",
            "item_ref": 103,
            "qty": 50,
            "notes": "Accessory Restock"
          }
        ]
      },
      {
      "id": "purchase_orders",
      "label": "Purchase Orders",
      "depends_on": "settings.enable_procurement",
      "list_template": {
        "template": "standard",
        "title_key": "po_number",
        "subtitle_key": "supplier",
        "trailing_key": "status"
      },
      "columns": [
        { "key": "po_number", "label": "PO #", "type": "text", "required": true },
        { 
          "key": "supplier", 
          "label": "Supplier", 
          "type": "relation", 
          "options": "crm.contacts", 
          "display_field": "name" 
        },
        { "key": "date", "label": "Order Date", "type": "date" },
        { "key": "status", "label": "Status", "type": "select", "options": ["Draft", "Ordered", "Received", "Cancelled"] },
        { 
          "key": "items", 
          "label": "Order Items", 
          "type": "table",
          "columns": [
            { 
              "key": "sku_ref", 
              "label": "Item", 
              "type": "relation", 
              "options": "variants", 
              "display_field": "full_name" 
            },
            { "key": "qty", "label": "Qty", "type": "number" },
            { "key": "cost", "label": "Unit Cost", "type": "currency" },
            { 
              "key": "line_total", 
              "label": "Total", 
              "type": "formula", 
              "formula": "=qty * cost" 
            }
          ]
        },
        {
          "key": "grand_total",
          "label": "Grand Total",
          "type": "rollup",
          "source_tab": "self.items",
          "source_field": "line_total",
          "function": "sum"
        }
      ],
      "initial_data": [
        {
          "record_id": 501,
          "po_number": "PO-2024-APPLE-01",
          "supplier": 1,
          "date": "2024-03-01",
          "status": "Received",
          "items": [
            {
              "sku_ref": 101,
              "qty": 10,
              "cost": 1200,
              "line_total": 12000
            },
            {
              "sku_ref": 102,
              "qty": 5,
              "cost": 2100,
              "line_total": 10500
            }
          ],
          "grand_total": 22500
        },
        {
          "record_id": 502,
          "po_number": "PO-2024-ACC-02",
          "supplier": 1,
          "date": "2024-03-10",
          "status": "Ordered",
          "items": [
            {
              "sku_ref": 103,
              "qty": 50,
              "cost": 25,
              "line_total": 1250
            }
          ],
          "grand_total": 1250
        }
      ]
      }
    ]
}