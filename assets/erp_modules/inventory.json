{
  "id": "inventory",
  "icon": "inventory_2_rounded",
  "primaryColor": "#2196F3",
  "version": "1.0",
  "settings": {
    "name": { "label": "Name", "type": "text", "value": "Inventory" },
    "has_multiple_warehouses": { 
      "label": "Do you have multiple warehouses?", 
      "type": "boolean", 
      "value": false 
    },
    "warehouses": { 
      "label": "Warehouses", 
      "type": "list", 
      "value": ["Main Warehouse"],
      "dependsOn": "has_multiple_warehouses" 
    }
  },
  "dashboard": {
    "kpiCards": [
      {
        "label": "Stock Worth",
        "calculation": "SUM(cost_price * qty)",
        "format": "currency"
      },
      {
        "label": "Shortages",
        "calculation": "COUNT(qty < 10)",
        "format": "number"
      }
    ]
  },
  "tabs": [
    {
      "id": "items",
      "label": "Item Catalog",
      "columns": [
        { "key": "item_image", "label": "Photo", "type": "image" },
        { "key": "item_name", "label": "Item Name", "type": "text" },
        { "key": "barcode_sku", "label": "SKU", "type": "scanner" },
        { "key": "is_item_variants", "label": "Does it have variants?", "type": "boolean" },
        { "key": "variant_name", "label": "Variant Name", "type": "text", "dependsOn": "is_item_variants" },
        { 
          "key": "variants", 
          "label": "Variants", 
          "type": "list",
          "dependsOn": "is_item_variants",
          "default": ["Small", "Big"]
        },
        { "key": "min_stock_alerts", "label": "Minimum Stock Alerts", "type": "number" }
      ]
    },
    {
      "id": "stock_ledger",
      "label": "Stock Entries",
      "columns": [
        { "key": "entry_date", "label": "Date", "type": "date" },
        { "key": "item_sku", "label": "Item SKU", "type": "scanner" },
        { 
          "key": "warehouse", 
          "label": "Warehouse", 
          "type": "select",
          "options": "settings.warehouses",
          "dependsOn": "settings.has_multiple_warehouses"
        },
        { "key": "batch", "label": "Batch Name", "type": "text" },
        { "key": "item_ref", "label": "Select Item", "type": "relation", "options": "items" },
        { "key": "qty", "label": "Quantity", "type": "number" },
        { "key": "cost_price", "label": "Unit Cost", "type": "currency" }
      ]
    }
  ]
}