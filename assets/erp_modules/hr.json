{
  "id": "hr",
  "name": "HR",
  "icon": "badge",
  "primaryColor": "#8B5CF6",
  "version": 1,
  "settings": {
    "id": {
      "label": "Module ID",
      "type": "text",
      "value": "hr"
    },
    "icon": {
      "label": "Icon",
      "type": "icon",
      "value": "badge"
    },
    "primaryColor": {
      "label": "Primary Color",
      "type": "color",
      "value": "#8B5CF6"
    },
    "version": {
      "label": "Version",
      "type": "text",
      "value": "1.0"
    },
    "name": {
      "label": "Name",
      "type": "text",
      "value": "HR",
      "help": "Main module title"
    },
    "extensions": {
      "label": "Extensions",
      "type": "list",
      "value": [
        "Leave Requests",
        "Recruitments",
        "Payroll",
        "Expense Claims"
      ]
    }
  },
  "dashboard": {
    "cards": [
      {
        "label": "Employees Records",
        "type": "kpi",
        "query": {
          "collection": "employees",
          "operation": "count"
        }
      },
      {
        "label": "Total Base Salary",
        "type": "kpi",
        "format": "currency",
        "query": {
          "collection": "employees",
          "operation": "sum",
          "field": "salary"
        }
      }
    ]
  },
  "collections": [
    {
      "id": "employees",
      "label": "Employees",
      "enable_custom_filters": true,
      "load_related_data": false,
      "list_template": {
        "template": "standard",
        "title_key": "name",
        "subtitle_key": "role",
        "trailing_key": "status",
        "detail_keys": [
          "department",
          "email",
          "phone"
        ]
      },
      "detail_template": {
        "template": "standard",
        "title_key": "name",
        "subtitle_key": "role",
        "show_all_fields": true
      },
      "quick_filters": [
        {
          "label": "Active",
          "key": "active",
          "rules": [
            {
              "field": "status",
              "operator": "==",
              "value": "Active"
            }
          ]
        },
        {
          "label": "Probation",
          "key": "probation",
          "rules": [
            {
              "field": "status",
              "operator": "==",
              "value": "Probation"
            }
          ]
        },
        {
          "label": "Sales",
          "key": "sales",
          "rules": [
            {
              "field": "department",
              "operator": "==",
              "value": "Sales"
            }
          ]
        },
        {
          "label": "Tech",
          "key": "tech",
          "rules": [
            {
              "field": "department",
              "operator": "==",
              "value": "Tech"
            }
          ]
        },
        {
          "label": "Ops",
          "key": "ops",
          "rules": [
            {
              "field": "department",
              "operator": "==",
              "value": "Ops"
            }
          ]
        }
      ],
      "initial_data": [
        {
          "record_id": 1,
          "name": "Sarah Miller",
          "role": "General Manager",
          "department": "Ops",
          "status": "Active",
          "email": "sarah.m@laptopstore.com",
          "phone": "+15551234567",
          "salary": 85000,
          "photo": ""
        },
        {
          "record_id": 2,
          "name": "David Chen",
          "role": "Lead Technician",
          "department": "Tech",
          "status": "Active",
          "email": "david.c@laptopstore.com",
          "phone": "+15559876543",
          "salary": 62000,
          "photo": ""
        },
        {
          "record_id": 3,
          "name": "Emily Johnson",
          "role": "Sales Associate",
          "department": "Sales",
          "status": "Probation",
          "email": "emily.j@laptopstore.com",
          "phone": "+15554567890",
          "salary": 45000,
          "photo": ""
        }
      ],
      "fields": [
        {
          "key": "photo",
          "label": "Photo",
          "type": "image"
        },
        {
          "key": "name",
          "label": "Full Name",
          "type": "text",
          "required": true
        },
        {
          "key": "role",
          "label": "Job Title",
          "type": "text"
        },
        {
          "key": "department",
          "label": "Department",
          "type": "select",
          "options": [
            "Sales",
            "Tech",
            "Ops",
            "HR"
          ]
        },
        {
          "key": "status",
          "label": "Status",
          "type": "select",
          "options": [
            "Active",
            "Probation",
            "Terminated"
          ]
        },
        {
          "key": "email",
          "label": "Work Email",
          "type": "email"
        },
        {
          "key": "phone",
          "label": "Phone",
          "type": "phone"
        },
        {
          "key": "salary",
          "label": "Base Salary",
          "type": "currency",
          "allowed_roles": [
            "admin"
          ]
        },
        {
          "key": "contract",
          "label": "Contract PDF",
          "type": "file",
          "allowed_roles": [
            "admin"
          ]
        }
      ]
    }
  ]
}
