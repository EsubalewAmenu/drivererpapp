
{
  "settings": {
    "id": { "label": "Module ID", "type": "text", "value": "crm" },
    "icon": { "label": "Icon", "type": "icon", "value": "people" },
    "primaryColor": { "label": "Primary Color", "type": "color", "value": "#4CAF50" },
    "version": { "label": "Version", "type": "text", "value": "1.0" },
    "name": { "label": "Name", "type": "text", "value": "CRM" }
  },
  "dashboard": {
    "cards": [
      {
        "label": "Total AR",
        "formula": "=SUMIF(contact_directory!F:F, \">0\")",
        "format": "currency"
      }
    ]
  },
  "tabs": [
    {
      "id": "contact_directory",
      "label": "Contact Directory",
      "enable_custom_filters": true,
      "list_template": {
        "template": "high_density",
        "title_key": "name",
        "subtitle_key": "type",
        "trailing_key": "balance"
      },
      "quick_filters": [
        { "label": "All Contacts", "key": "all", "field": "type", "operator": "contains", "value": "" },
        { "label": "Clients", "key": "clients", "field": "type", "operator": "==", "value": "CLIENT" },
        { "label": "Suppliers", "key": "suppliers", "field": "type", "operator": "==", "value": "SUPPLIER" },
        { "label": "Overdue", "key": "overdue", "field": "balance", "operator": ">", "value": 0 }
      ],
      "columns": [
        { "key": "uuid", "label": "ID", "type": "text", "hidden": true },
        { "key": "is_individual", "label": "Is individual?", "type": "boolean" },
        { "key": "name", "label": "Full Name", "type": "text", "depends_on": "is_individual", "required": true },
        { "key": "company_name", "label": "Company Name", "type": "text", "depends_on": "!is_individual", "required": true },
        { "key": "company_tin", "label": "Company TIN", "type": "text", "depends_on": "!is_individual" },
        { "key": "type", "label": "Business Role", "type": "select", "options": ["CLIENT", "SUPPLIER", "BOTH"], "required": true },
        { "key": "phone", "label": "Phone", "type": "phone" },
        { "key": "email", "label": "Email", "type": "email" },
        { "key": "balance", "label": "Ledger Balance", "type": "currency" },
        { "key": "notes", "label": "Intelligence", "type": "text" }
      ]
    }
  ]
}
