
{
  "settings": {
    "id": { "label": "Module ID", "type": "text", "value": "crm" },
    "icon": { "label": "Icon", "type": "icon", "value": "people" },
    "primaryColor": { "label": "Primary Color", "type": "color", "value": "#4CAF50" },
    "version": { "label": "Version", "type": "text", "value": "1.0" },
    "name": { "label": "Name", "type": "text", "value": "CRM" },
  
    "enable_sales": { 
      "label": "Sales Pipeline", 
      "type": "boolean", 
      "value": true 
    },
    "enable_support": { 
      "label": "Helpdesk", 
      "type": "boolean", 
      "value": false 
    }

  },
  "dashboard": {
    "cards": [
      {
        "label": "Total Customers",
        "formula": "=COUNTIF(contacts!D:D, \"Customer\")",
        "format": "number"
      },

      {
        "label": "Pipeline Value",
        "formula": "=SUM(deals!D:D)", 
        "format": "currency"
      },
      {
        "label": "Open Tickets",
        "formula": "=COUNTIF(tickets!C:C, \"Open\")",
        "format": "number"
      }
    ]
  },
  "tabs": [
    {
      "id": "contacts",
      "label": "Directory",
      "enable_custom_filters": true,
      "list_template": {
        "template": "standard",
        "title_key": "name",
        "subtitle_key": "company_name",
        "trailing_key": "type",
        "detail_keys": ["email", "phone"]
      },
      "detail_template": {
        "template": "standard",
        "title_key": "name",
        "subtitle_key": "type",
        "show_all_fields": true
      },
      "quick_filters": [
        { "label": "Individuals", "key": "individuals", "field": "type", "operator": "==", "value": "Individual" },
        { "label": "Companies", "key": "companies", "field": "type", "operator": "==", "value": "Company" },
        { "label": "Customers", "key": "customer", "field": "status", "operator": "==", "value": "Customer" },
        { "label": "Lead", "key": "lead", "field": "status", "operator": "==", "value": "Lead" },
        { "label": "Suppliers", "key": "supplier", "field": "status", "operator": "==", "value": "Supplier" }
      ],
      "initial_data": [
        {
          "type": "Individual",
          "name": "Oliver A.",
          "tin": "N/A",
          "company": "171234343",
          "status": "Supplier",
          "email": "esubalewbusiness@gmail.com",
          "phone": "+971551266787",
          "photo": "",
          "website": "",
          "notes": "Software and mobile apps developer"
        },
        {
          "type": "Company",
          "name": "DataScience Private Limited",
          "tin": "0104111145",
          "company": "",
          "status": "Supplier",
          "email": "datascienceplc@gmail.com",
          "phone": "+251923481783",
          "website": "https://datascienceplc.com",
          "notes": "Software development and data analysis services provider"
        }
      ],
      "columns": [
        { "key": "type", "label": "Type", "type": "select", "options": ["Individual", "Company"], "default": "Individual" },
        { "key": "name", "label": "Name", "type": "text", "required": true },
        { "key": "tin", "label": "TIN", "type": "text"},
        { "key": "company", "label": "Company", "type": "relation", "depends_on": "type", "depends_value": "Individual", "options": "contacts" },
        { "key": "status", "label": "Stage", "type": "select", "options": ["Lead", "Customer", "Supplier"] },
        { "key": "email", "label": "Email", "type": "email" },
        { "key": "phone", "label": "Phone", "type": "phone" },
        { "key": "website", "label": "Website", "type": "text" },
        { "key": "photo", "label": "Photo", "type": "image" },
        { "key": "notes", "label": "Note", "type": "text" }
      ]
    },

    {
      "id": "deals",
      "label": "Sales Pipeline",
      "depends_on": "settings.enable_sales",
      "list_template": {
        "template": "kanban", 
        "group_by": "stage",
        "title_key": "deal_name",
        "subtitle_key": "amount",
        "trailing_key": "owner"
      },
      "columns": [
        { "key": "deal_name", "label": "Deal Name", "type": "text", "required": true },
        { 
          "key": "related_contact", 
          "label": "Customer", 
          "type": "relation", 
          "options": "contacts", 
          "display_field": "name" 
        },
        { 
          "key": "stage", 
          "label": "Stage", 
          "type": "select", 
          "options": ["New", "Qualified", "Proposal", "Negotiation", "Won", "Lost"] 
        },
        { "key": "amount", "label": "Value", "type": "currency" },
        { "key": "close_date", "label": "Expected Close", "type": "date" },
        { "key": "owner", "label": "Owner", "type": "email", "default": "user.email", "readonly": true }
      ]
    }
  ]
}