  "dashboard": {
    "cards": [
      {
        "label": "Stock Ledger Records",
        "type": "kpi",
        "query": {
          "collection": "stock_ledger",
          "operation": "count"
        }
      },
      {
        "label": "Total Qty",
        "type": "kpi",
        "format": "number",
        "query": {
          "collection": "stock_ledger",
          "operation": "sum",
          "field": "qty"
        }
      }
    ]
  },
  "collections": [
    {
      "id": "stock_ledger",
      "label": "Stock Ledger",
      "enable_custom_filters": true,
      "list_template": {
        "template": "standard",
        "title_key": "item_ref",
        "subtitle_key": "type",
        "trailing_key": "qty"
      },
      "detail_template": {
        "template": "standard",
        "title_key": "item_ref",
        "subtitle_key": "type",
        "show_all_fields": true
      },
      "quick_filters": [
        {
          "label": "Stock In",
          "key": "stock_in",
          "rules": [
            {
              "field": "type",
              "operator": "==",
              "value": "In"
            }
          ]
        },
        {
          "label": "Stock Out",
          "key": "stock_out",
          "rules": [
            {
              "field": "type",
              "operator": "==",
              "value": "Out"
            }
          ]
        }
      ],
      "fields": [
        {
          "key": "date",
          "label": "Date",
          "type": "date"
        },
        {
          "key": "type",
          "label": "Type",
          "type": "select",
          "options": [
            "In",
            "Out"
          ]
        },
        {
          "key": "item_ref",
          "label": "Item",
          "type": "relation",
          "options": "variants",
          "display_field": "full_name"
        },
        {
          "key": "qty",
          "label": "Qty",
          "type": "number"
        },
        {
          "key": "notes",
          "label": "Note",
          "type": "text"
        }
      ],
