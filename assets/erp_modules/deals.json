
{
  "settings": {
    "id": { "label": "Module ID", "type": "text", "value": "deals" },
    "icon": { "label": "Icon", "type": "icon", "value": "shopping_cart" },
    "primaryColor": { "label": "Primary Color", "type": "color", "value": "#4CAF50" },
    "version": { "label": "Version", "type": "text", "value": "1.0" },
    "name": { "label": "Name", "type": "text", "value": "Deals" },
  
    "depends_on": ["crm"]
  },
  "dashboard": {
    "cards": [
      {
        "label": "Pipeline Value",
        "formula": "=SUM(deals!D:D)", 
        "format": "currency"
      }
    ]
  },
  "tabs": [
    {
      "id": "deals",
      "label": "Sales Pipeline",
      "enable_custom_filters": true,
      "load_sub_table_data_automatically": false,
      "list_template": {
        "template": "kanban", 
        "group_by": "stage",
        "title_key": "deal_name",
        "subtitle_key": "amount",
        "trailing_key": "owner"
      },
      "detail_template": {
        "template": "standard",
        "title_key": "deal_name",
        "subtitle_key": "amount",
        "show_all_fields": true
      },
      "initial_data": [
        {
          "deal_name": "Staff financing deal",
          "related_contact": 2,
          "stage": "New",
          "amount": 120000,
          "close_date": "2026-01-30",
          "owner": "esubalewbusiness@gmail.com",
          "record_id": 1
        }
      ],
      "quick_filters": [
         { "label": "My Deals", "key": "my_deals", "field": "owner", "operator": "==", "value": "user.email" },
         { "label": "New", "key": "new_stage", "field": "stage", "operator": "==", "value": "New" }
      ],
      "columns": [
        { "key": "deal_name", "label": "Deal Name", "type": "text", "required": true },
        { "key": "amount", "label": "Amount", "type": "currency" },
        { 
          "key": "related_contact", 
          "label": "Customer", 
          "type": "relation", 
          "options": "contacts", 
          "display_field": "name" 
        },
        { 
          "key": "letter_status", 
          "label": "Letter Status", 
          "type": "select", 
          "options": ["Not Started", "Out for Delivery", "Delivered"] 
        },
        { 
          "key": "call_status", 
          "label": "Call Status", 
          "type": "select", 
          "options": ["Pending", "No Answer", "Gatekeeper", "Spoke to GM"] 
        },
        { 
          "key": "stage",
          "label": "Outcome", 
          "type": "select", 
          "options": ["Pending", "Not Interested", "Send Email", "Call Back", "Meeting Set", "Proposal Sent", "Negotiation", "Closed Won", "Closed Lost"] 
        },
        { "key": "next_follow_up", "label": "Next Follow Up", "type": "date" },
        { "key": "close_date", "label": "Expected Close", "type": "date" },
        { "key": "owner", "label": "Owner", "type": "email", "default": "user.email", "readonly": true }
      ]
    }
  ]
}